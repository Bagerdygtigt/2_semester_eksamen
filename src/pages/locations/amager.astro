---
import Singleview from "../../components/Singleview.astro";
import MainLayout from "../../layout/MainLayout.astro";
import KontaktForm from "../../components/KontaktForm.astro";
---

<MainLayout>

<Singleview
reverse={true}
title="Butikken på Amager"
subtitle="Om butikken"
text="På en livlig gade på Amagerbro finder du Bagerdygtigts fjerde butik, som åbnede i 2018. Her har du mulighed for at holde arrangementer i vores store selskabslokale. Uanset om det er en fødselsdag, et møde eller en fejring med venner og familie, sørger vi for en atmosfære, hvor god samvittighed og god stemning går hånd i hånd."
image="/imgs/amager1.webp"
/>

<Singleview
subtitle="Adresse"
adress="Valby langgade 185, 2500 Valby"
hours="Åbningstider"
times="Man-fre 6.00 - 17.30 Lør-søn 6.00 - 16.30"
image="/imgs/amager2.webp"
/>

<div class="grid_1-1">
<Singleview
reverse={true}
image="/imgs/amager3.webp"
/>
<div class="order">
<h2>Spørgsmål? Skriv  til os</h2>
<KontaktForm></KontaktForm>
</div>
</div>

</MainLayout>


<style>

.grid_1-1 {
    display: grid;
}

    .grid_1-1 .order {
        order: -1;
    }

    @media (min-width: 800px) {
    .grid_1-1 {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .grid_1-1 .order {
        order: 100;
        padding: 70px;
    }

    }
</style>