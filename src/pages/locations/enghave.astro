---
import Singleview from "../../components/Singleview.astro";
import MainLayout from "../../layout/MainLayout.astro";
---

<MainLayout>
    <Singleview 
    title="Butikken på Enghave"
    text="Vores femte butik slog dørene op på Enghavevej i 2020. Her kan du nyde vores populære microbrunch.  Du kan helt selv sammensætte din egen microbrunch med brød, pålæg, wienerbrød og juice. Alt med omtanke for både smag og bæredygtighed."
    adress="Enghavevej 71, <br> 1674 KBH V"
    times="Man-fre 6.00 - 17.30 <br> Lør-søn 6.00 - 16.30"
    image="/imgs/enghave1.webp"
    imagetwo="/imgs/enghave2.webp"
    imagethree="/imgs/enghave3.webp"
    illustration="/imgs/blomst.webp"
    />
</MainLayout>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll(".fade-in").forEach((card) => {
    // card.classList.add("fade-in");
    observer.observe(card);
  });
</script>