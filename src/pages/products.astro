---
import MainLayout from "../layout/MainLayout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import TopGrid from "../components/TopGrid.astro";
import BottomGrid from "../components/BottomGrid.astro";
import "../style/style.css";

const data = await fetch("https://zbrjayekwqwkywlpbbas.supabase.co/rest/v1/bagerdygtigsprodukter", {
  method: "GET",
  headers: {
    apikey: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpicmpheWVrd3F3a3l3bHBiYmFzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDcxNDk4MDcsImV4cCI6MjA2MjcyNTgwN30.tQZl_c2h8IkBAMemoVQM0NdeNeGIdpMpRpBVKU3DWvU",
  },
}).then((res) => res.json());
---

<MainLayout>
  <TopGrid />

  <div class="grid_1-1-1-1-1">
    <a class="category activ alt" href="/products">Alt bagværk</a>
    <a class="category" href="/broed">Brød</a>
    <a class="category" href="/boller">Boller</a>
    <a class="category" href="/kage">Kage</a>
    <a class="category" href="/wienerbroed">Wienerbrød</a>
  </div>

  <section class="grid_1-1-1">
    {
      data.map((products) => {
        return <ProductGrid data={products} />;
      })
    }
  </section>
  <BottomGrid />
</MainLayout>
<style>
  h1 {
    font-family: "Bebas Neue", sans-serif;
  }
  .category {
    background: none;
    border: none;
    color: var(--color-secondary);
    padding-right: 4rem;
    text-decoration: none;
    font-size: 16px;
    font-family: var(--font-tagline);
    cursor: pointer;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-weight: 400;
  }
  .alt {
    margin-top: 2rem;
  }

  .category:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2.5px;
    transition:
      text-decoration-color 0.5s ease,
      text-decoration-thickness 0.5s ease;
  }

  .activ {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2.5px;
    text-underline-offset: 6px;
  }

  /*************** Kategorierne Resposivt ***************/
  @media (max-width: 1050px) {
    .grid_1-1-1-1-1 {
      display: grid;
      grid-template-columns: 1fr;
    }
  }

  /************* Desktop ***************/
  @media (min-width: 800px) {
    .grid_1-1-1 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }
  }
  /************* Tablet Version ******************/
  @media (min-width: 800px) and (max-width: 1000px) {
    .grid_1-1-1 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
</style>
