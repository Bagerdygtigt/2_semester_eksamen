const { myData } = Astro.props;
console.log(myData);
---

<MainLayout title={myData.productname}>
  <section class="grid_1-1 grid2_1-1">
    <div>
      <h1>{myData.category}</h1>
    </div>
    <div class="shoppicture">
      <img src="/imgs/shop.webp" alt="Shop billede" />
    </div>
  </section>
  <section class="grid_1-1">
    <div>
      <img src={myData.imgs} alt={myData.productname} />
    </div>
    <div>
      <h2>{myData.productname}</h2>
      <h3>Ingredienser:</h3>
      <ul class="ingredienser">
        {myData.ingrediens.split(",").map((item) => (
          <li>{item.trim()}</li>
        ))}
      </ul>

      <img class="singleviewpicture" src="/imgs/singleview.webp" alt="" />


      <div class="grid_1-1">
        <div>
          <p class="antal">ANTAL:</p>
      
          <section class="counter-wrapper">
            {
            <button id="minus">-</button>
              <button id = "counter">0</button> 
                <button id="plus">+</button>
            }
          </section>
      
          <Button variant="primary" size="small">TILFØJ TIL KURV</Button>
        </div>
      </div>
    </div>
  </section>
  <script type="module">
    document.addEventListener("DOMContentLoaded", () => {
    let count = 0;

    const counterDisplay = document.getElementById("counter");
    const plusBtn = document.getElementById("plus");
    const minusBtn = document.getElementById("minus");

    plusBtn.addEventListener("click", () => {
        count += 1;
        counterDisplay.textContent = count;
    });

    minusBtn.addEventListener("click", () => {
        count -= 1;
        counterDisplay.textContent = count;
    });
});
</script>


  <style>

.grid2_1-1{
  display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
}
.shoppicture{
      margin-bottom: 2rem;
    }
.counter-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 2px solid var(--color-accent);
    border-radius: 3px;
    margin-bottom: 0.7rem;
    width: fit-content;
  } 

  button {
    padding: 0.5rem 1rem;
    font-size: 1.2rem;
    border: var(--color-accent);
    color: var(--color-accent);
    cursor: pointer;
    background-color: transparent;
  }

  #counter {
    min-width: 2rem;
    text-align: center;
    font-size: 1.2rem;
  }

  .antal{
 margin-top: 1.5rem;
}
.ingredienser {
  list-style: none;
  font-family: var(--font-base);
  font-size: var(--font-size-p-small);
  font-weight: var(--font-weight-normal);
  line-height: var(--line-height-m);
  color: var(--color-text);
  margin-bottom: var(--spacing-2);
  margin-top: 1rem;
  max-width: 70ch;
}
.singleviewpicture{
width: 5%;
margin-top: 1rem;
}
    @media (min-width: 1250px) {
      .grid_1-1 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      h2 {
        font-size: 30px;
        margin-top: 0rem;
      }
      h3 {
        font-size: 25px;
      }

      h1 {
        margin-top: 3rem;
      }

    }

    @media (min-width: 1050px) and (max-width: 1250px){
      .grid_1-1 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      h2{
        margin-top: 0rem;
      }

   }
  </style>
</MainLayout>
