---
import LokationCards from "../components/LokationCards.astro";
import MainLayout from "../layout/MainLayout.astro";
---

<MainLayout>
  <section class="flexbox_1">
    <div>
    <h1>BUTIKKER</h1>
    <h3>Leder du efter bagværk til firmaet eller private events og catering? <br> Kontakt en af vores butikker her:</h3>
    </div>
    <img class="stolpicture" src="/imgs/stol.webp" alt="blomstillustration" />
  </section>   

<section class="grid_1-1-1">
<LokationCards 
image="/imgs/valby1.webp"
title="Valby"
adress="Valby langgade 185, <br> 2500 Valby"
times="Man-fre 6.00 - 17.30<br>Lør-søn 6.00 - 16.30"
illustration="/imgs/blomst.webp"
link="/locations/valby"
/>
<LokationCards 
image="/imgs/istedgade1.webp"
title="Vesterbro"
adress="Istedgade 120, <br> 1650 KBH V"
times="Man-fre 6.00 - 17.30 <br> Lør-søn 6.00 - 17.30"
illustration="/imgs/coffeepicture.webp"
link="/locations/vesterbro"
/>
<LokationCards 
image="/imgs/amager1.webp"
title="Amager"
adress="Amagerbrogade 72, <br> 2300 KBH S"
times="Man-fre 6.30 - 17.30 <br> Lør-søn 7.00 - 16.30"
illustration="/imgs/kurv.webp"
link="/locations/amager"
/>
<LokationCards 
image="/imgs/sydhavn1.webp"
title="Sydhavn"
adress="Borgbjergsvej 39, <br> 2450 KBH SV"
times="Man-fre 6.00 - 17.30 <br> Lør-søn 7.00 - 16.30"
illustration="/imgs/kager.webp"
link="/locations/sydhavn"
/>
<LokationCards 
image="/imgs/enghave1.webp"
title="Enghave"
adress="Enghavevej 71, <br> 1674 KBH V"
times="Man-fre 6.00 - 17.30 <br> Lør-søn 6.00 - 17.30"
illustration="/imgs/blomst.webp"
link="/locations/enghave"
/>  
</section>

</MainLayout>

<style>
.flexbox_1 {
display: flex;
flex-direction: row;
justify-content: space-between;
padding-bottom: 2rem;
gap: 2rem;

h3 { font-size: 0.8rem;}
}

.stolpicture {
  width: 30vw;
  height: auto;
  display: block;
  aspect-ratio: 353 / 224;
  object-fit: contain;
}

@media (min-width: 800px) {

.flexbox_1 {
  padding-top: 2rem;
  h3 {
    font-size: var(--font-size-h3);
  }
}

.grid_1-1-1 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 40px;
}

.stolpicture {
  max-width: 300px;
}
}
</style>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll(".fade-in").forEach((card) => {
    // card.classList.add("fade-in");
    observer.observe(card);
  });
</script>