---
const currentPath = Astro.url.pathname;
---

<nav class="site-header">
  <div class="logo">
    <a href="/" class="logo"><img src="/imgs/bagerdygtigt_logo.svg" alt="" /></a>
  </div>

  <ul class="menu">
    <li><a href="/products" class={currentPath === "/products" ? "active" : ""}>SHOP BAGVÆRK</a></li>
    <li><a href="/menukort" class={currentPath === "/menukort" ? "active" : ""}>MENUKORT</a></li>
    <li><a href="/bagerier" class={currentPath === "/bagerier" ? "active" : ""}>BAGERIER</a></li>
    <li><a href="/baeredygtighed" class={currentPath === "/baeredygtighed" ? "active" : ""}>BÆREDYGTIGHED</a></li>
    <li class="kurv">
      <svg class="kurv-ikon" width="533" height="528" viewBox="0 0 533 528" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M508.019 356.567H240.019C216.52 356.567 220.52 313.567 240.019 313.567H516.519C538.019 313.567 535.019 266.567 516.519 266.567H17.5191C-5.98047 266.567 -2.98099 313.567 17.5191 313.567H78.0191C100.02 313.567 99.0195 356.567 78.0191 356.567H28.5192C30.9192 444.967 108.352 506.734 146.019 526.567H398.519C477.319 471.367 502.686 390.234 508.019 356.567Z"
          fill="currentColor" stroke="currentColor"/>
        <path d="M47.5205 222.069H94.5205C94.5205 -7.43263 440.021 -23.4326 440.021 222.069H489.521C489.521 -75.4333 47.5205 -69.9331 47.5205 222.069Z"
          fill="currentColor" stroke="currentColor"/>
      </svg>
    </li>
    
    
  </ul>
  <div>
    <div class="burger">
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
    </div>
  </div>

  <style>
    /************ Menu ***********/
    .menu a.active {
      border-bottom: 2px solid var(--color-accent);
      text-decoration: none;
    }

    nav {
      height: 100%;
      padding: 0.5rem 1rem;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      width: 100px;
      padding: 10px;
    }

    .menu {
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
      margin-left: auto;
      gap: 30px;
    }

    .menu li {
      border-width: 5cm;
    }

    .menu li:hover {
      color: black;
      transition: all 0.3s ease;
    }

    .menu li:last-child {
      margin-right: 10px;
    }

    .menu a {
      display: block;
    }

    .burger {
      width: 30px;
      height: 20px;
      cursor: pointer;
    }

    .burger .line {
      width: 100%;
      height: 2px;
      background-color: black;
      margin-bottom: 5px;
      transition: 0.2s linear;
    }

    .burger {
      display: none;
    }

    .menu .kurv {
      display: flex;
      align-items: center;
    }

    .menu .kurv img {
      height: 1em;
      width: auto;
      vertical-align: middle;
    }

    .kurv-ikon {
  width: 1.1em;
  height: auto;
  color: black;
  transition: color 0.3s ease;
  cursor: pointer;
}

.kurv:hover .kurv-ikon {
  color: var(--color-secondary);
}


    /*********************************** a tags generelt ******************************/

    a {
      color: var(--color-text);
      text-decoration: none;
      transition:
        color 0.3s,
        text-decoration-thickness 0.3s ease;
      text-decoration-thickness: 0;
      transition: color 0.3s ease;
    }

    a:hover {
      color: var(--color-secondary);
      font-weight: var(--font-weight-bold);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /*********************************** Burgermenu ******************************/

    @media screen and (max-width: 1050px) {
      .menu {
        display: none;
      }

      .burger {
        display: block;
        margin-right: 0.5rem;
      }

      .burger.active .line:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
        transition: 0.2s linear;
      }

      .burger.active .line:nth-child(2) {
        opacity: 0;
        transition: 0.15s linear;
      }

      .burger.active .line:nth-child(3) {
        transform: rotate(-45deg) translate(5px, -5px);
        transition: 0.2s linear;
      }

      nav.active .menu {
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: var(--color-primary);
        position: absolute;
        top: 0px;
        left: 0;
        width: 100%;
        margin-top: 6%;
        box-shadow: 0 10px 10px rgba(0, 0, 0, 0.1);
        z-index: 1;
        height: 1000px;
      }

      nav.active .menu li {
        margin: 20px 0;
        padding: 0.5rem 0;
        text-align: center;
      }

      li {
        clear: left;
        width: 95%;
      }

      nav.active .menu a {
        font-size: 16px;
        text-align: center;
      }
      nav.active .menu li {
    margin: 20px 0;
    padding: 0.5rem 0;
    text-align: center;
  }

  nav.active .menu .kurv {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  nav.active .menu .kurv img {
    height: 1.5em;
  }
}


    }
  </style>

  <script>
    const burger = document.querySelector(".burger");
    const nav = document.querySelector("nav");
    const menu = document.querySelector(".menu");

    burger.addEventListener("click", burgerClick);
    function burgerClick() {
      burger.classList.toggle("active");
      nav.classList.toggle("active");
    }

    menu.addEventListener("click", menuClick);
    function menuClick() {
      burger.classList.remove("active");
      nav.classList.remove("active");
    }
  </script>
</nav>
