---
import "../style/style.css";
---

<section class="grid_1-1">
  <h1 class="retoverskrift">SHOP BAGVÆRK</h1>
  <img class="shoppicture" src="/imgs/shop.webp" alt="Brød og bagværk" />
</section>

<style>
  .shoppicture {
    margin-top: 2rem;
  }

  @media (min-width: 800px) {
    .grid_1-1 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
  .retoverskrift {
    margin-top: 2rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: 4.5rem;
  }
</style>
