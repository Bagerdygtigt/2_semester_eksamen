---
const {image, alt, title, adress, times, link, illustration} = Astro.props;
import Button from "../components/Button.astro";
---

<div class="locationcard fade-in">
    <img class="frontpic" src={image} alt={alt}>
    <div class="grid_1-1">
      <div>
        <h2>{title}</h2>
        <p set:html={adress}></p>
          <h3>Åbningstider</h3>
          <p set:html={times}></p>
          <a href={link}><Button variant="primary" size="small" >LÆS MERE</Button></a>
        </div>
        <div>
        <img class="cardillustration" src={illustration} alt="illustration">
        </div>
    </div>
</div>

<style>

.grid_1-1{
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding-bottom: 2rem;
  gap: 20px;
}


.cardillustration {
  width: 140px; 
  padding-top: 2rem;
  padding-left: 0.5rem;
}

a {
  text-decoration: none;
}

@media (min-width: 800px) {

  .locationcard {
  max-width: 350px;
}
.cardillustration {
  display: none;
}
}
</style>