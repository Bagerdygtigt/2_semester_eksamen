---
import KontaktForm from "./KontaktForm.astro";

const {image, imagetwo, imagethree, illustration, alt, title, adress, text, times} = Astro.props;
---

<div class="section_1">
  <div class="order">
    <h1>{title}</h1>
    <h3>Om butikken</h3>
    <p>{text}</p>
</div>
    <div>
        <img src={image} alt={alt} />
    </div>
</div>

<div class="section_2">
  <div class="section_2-1">
    <div>
    <h3>Adresse</h3>
    <p set:html={adress}></p>
    <h3>Åbningstider</h3>
    <p set:html={times}></p>
    </div>
    <img class="illustration" src={illustration} alt={alt}>
</div>
    <div>
        <img src={imagetwo} alt={alt} />
    </div>
</div>

<div class="section_3">
  <div class="order">
    <h3>Spørgsmål? Skriv til os</h3>
    <KontaktForm></KontaktForm>
    </div>
    <div>
        <img src={imagethree} alt={alt} />
    </div>
</div>


<style>
  .section_1, 
  .section_2, 
  .section_3 {
    padding-top: 2rem;
    padding-bottom: 2rem;

  }

.section_2-1 {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 30px;
padding-bottom: 2rem;
}

.illustration {
    height: auto;
    max-width: 150px;
  }

   img {
    height: auto;
    max-width: 580px;
    }

    @media (min-width: 800px) {

        .section_1, 
        .section_2, 
        .section_3 {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 4rem;
          padding-top: 4rem;
          h1{
            font-size: 2.7rem;
          }
        }

        .section_1 .order {
          order: 100;
          padding-right: 2rem;
        }

        .section_3 .order {
          order: 100;
          padding-right: 3rem;
        }
    }

</style>