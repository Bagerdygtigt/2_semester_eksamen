---
import Button from "../components/Button.astro";
---

<section class="hero">
  <img src="/imgs/heroimg.webp" alt="Hero image af Bagerdygtigts istedgade butiksfront" />
  <div class="hero-content">
    <h1>Bagerdygtigt</h1>
    <a href="#products">
      <Button variant="secondary" size="small">SHOP BAGVÆRK</Button>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    margin: 0;
    padding: 0;
    /* Bryd ud af main container */
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    /* Kompensér for main's padding */
    margin-left: calc(-50vw + 50% - 2rem);
    margin-right: calc(-50vw + 50% - 2rem);
  }

  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-content {
    position: absolute;
    top: 50%;
    left: 20%;
    transform: translate(-10%, -50%);
    text-align: left;
    padding: 1rem;
    color: #f9aa16;
  }

  .hero-content a {
    text-decoration: none;
  }

  h1 {
    font-size: 6rem;
    margin: 0 0 1.5rem 0;
    line-height: 1.1;
  }

  /* Tablet styles */
  @media (max-width: 768px) {
    .hero {
      /* Justér margins på tablet også */
      margin-left: calc(-25vw + 25%);
      margin-right: calc(-25vw + 25%);
    }
    .hero-content {
      left: 10%;
      top: 45%;
      padding: 1rem 0.5rem;
    }

    h1 {
      font-size: 4rem;
      margin-bottom: 1.2rem;
    }
  }

  /* Mobile styles */
  @media (max-width: 480px) {
    .hero-content {
      left: 5%;
      right: 5%;
      top: 40%;
      transform: translateY(-50%);

      padding: 1rem;
    }

    h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      line-height: 1.2;
    }
  }

  /* Extra small mobile */
  @media (max-width: 320px) {
    h1 {
      font-size: 2rem;
    }

    .hero-content {
      padding: 0.5rem;
    }
  }
</style>
