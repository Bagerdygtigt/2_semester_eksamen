---
const { variant, size } = Astro.props;
---

<button class={variant + " " + size}><slot /></button>

<style>
  button {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    color: var(--color-primary);
    background-color: transparent;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .primary,
  .secondary {
    border-style: solid;
    border-width: 2px;
    border-radius: 3px;
  }

  .primary {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .primary:hover {
    background-color: var(--color-accent);
    color: var(--color-primary);
  }

  .secondary {
    border-color: #d8dcbb;
    color: var(--color-primary);
  }

  .secondary:hover {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
  }

  .big {
    width: 100%;
    max-width: 500px;
    height: 40px;
  }

  .medium {
    width: 100%;
    max-width: 370px;
    height: 40px;
  }

  .small {
    width: 100%;
    max-width: 200px;
    height: 40px;
  }
</style>
